{
    "Statement": [
        {
            "Action": [
                "s3:PutObject",
                "s3:CreateBucket",
                "rds:CreateDBInstance",
                "lambda:CreateFunction",
                "elasticache:CreateCacheCluster",
                "ec2:RunInstances",
                "ec2:CreateVolume",
                "dynamodb:CreateTable"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalARN": "arn:aws:iam::*:role/aws-tag-governance-deny-policy-exemption-role"
