            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalARN": "arn:aws:iam::*:role/aws-tag-governance-deny-policy-exemption-role"
                },
                "ForAnyValue:StringEquals": {
                    "aws:TagKeys": [
